# Copy to .env for local development. Inside Databricks (notebook, Job, or
# Databricks App), none of the DATABRICKS_* auth vars below are needed --
# the SDK picks up the attached compute's own credentials automatically.
# They're only here for running jobs/tests from a laptop.

# Databricks workspace auth (local dev only)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# SQL warehouse (used by agent/tools.py's non-mock read path)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=

# Lakebase (Postgres)
LAKEBASE_HOST=
LAKEBASE_PORT=5432
LAKEBASE_DATABASE=civicpulse
LAKEBASE_USER=
LAKEBASE_PASSWORD=

# When true (default), agent/tools.py and the app's dashboard/history pages
# return small labeled mock datasets instead of hitting live infrastructure —
# lets the whole repo run/demo with zero external connections.
CIVICPULSE_MOCK_MODE=true
